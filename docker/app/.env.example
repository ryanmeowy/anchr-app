# Anchr App · 演示环境变量
#
# 本文件面向 demo 分支的演示部署：演示开关与隔离项默认全部生效。
#
# 用法：
#   cp docker/app/.env.example docker/app/.env   然后填入标空的密钥
#   标注【必填】的项缺失会导致启动失败。
#   填完后对照文末的自查清单过一遍。
#
# 安全提醒：本文件不能提交到 git（docker/app/.env 已在 .gitignore 中）。
# 真实密钥只存在于服务器和本地开发机上。

# ─────────────────────────────────────────────────────────────────────────────
# 1. 服务本体
# ─────────────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
# 本地开发用 dev，服务器建议 prod（dev 会打开更详细的日志与错误信息）
PROFILES_ACTIVE=prod

# ─────────────────────────────────────────────────────────────────────────────
# 2. MySQL
# ─────────────────────────────────────────────────────────────────────────────
# 下面的 mysql / redis / elasticsearch 是 Docker 服务名，不是笔误。
# 前提：本服务通过 docker/app/compose.yml 启动，并加入 external 网络 anchr-backend，
#       infra 容器在该网络内的服务名正好是这几个。Docker 内置 DNS 会把服务名解析成
#       容器当前 IP，所以不要写死 IP —— 容器重启后 IP 会变，写死就连不上了。
#
# 若你在非 Docker 环境直接 java -jar 运行，要把它们换成实际地址：
#   mysql → 127.0.0.1        redis → 127.0.0.1
#   elasticsearch → 127.0.0.1:9200
#   （docling 本来就不在 compose 里，模板里已是实际地址）
#
# 【必填】连接串。注意时区必须是 Asia/Shanghai，否则每日配额会在错误的时间点重置。
# 库名必须与 docker/infra/.env 里的 MYSQL_DATABASE 一致（默认 anchr），
# 容器首次启动时由 MySQL 镜像按该变量创建数据库。
MYSQL_URL='jdbc:mysql://mysql:3306/anchr?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai'
MYSQL_USER=anchr
MYSQL_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# 3. Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 演示隔离：令牌、配额计数、熔断开关都写在这个库里，与主业务分开。
#
# 【演示环境必填，且不能注释掉】
#   application.yaml 里写死了 database: 0，但 Spring Boot 的这个环境变量优先级更高，
#   设了就以这里为准。实测设成 4 后，demo:quota:* 确实落在 db4、db0 里查不到。
#   不设的话演示令牌会和正式数据混在 db0，写操作互相干扰。
#
# 普通部署（非演示）保持注释即可。
SPRING_DATA_REDIS_DATABASE=4

# ─────────────────────────────────────────────────────────────────────────────
# 4. Elasticsearch
# ─────────────────────────────────────────────────────────────────────────────
# 【必填】这三项在代码里是 @Value("${ES_HOST}") 直接注入，没有默认值，缺了启动即失败。
ES_HOST=elasticsearch:9200
ES_USERNAME=elastic
ES_PASSWORD=

# 演示隔离：ES 索引前缀，避免和主环境互相污染。
#
# 【演示环境必填，且不能注释掉】
#   设成 demo_kb_segment 后，程序实际使用：
#     物理索引前缀  demo_kb_segment
#     读别名        demo_kb_segment_read
#     写别名        demo_kb_segment_write
#   注意是「前缀_后缀」的拼接方式，不要自己写 demo_kb_segment_read。
#   不设就落到默认的 kb_segment，与主环境的索引混在一起。
ANCHR_SEGMENT_INDEX=demo_kb_segment

# ─────────────────────────────────────────────────────────────────────────────
# 5. 应用密钥
# ─────────────────────────────────────────────────────────────────────────────
# 【必填】管理接口密钥。用于 /auth/refresh-token、/auth/demo/kill-switch 等。
# 建议用 openssl rand -base64 32 生成。
APP_ADMIN_SECRET=

# 【必填】敏感字段加密密钥（存储配置里的 AK/SK 用它加密落库）。
# 必须是 Base64 编码的 32 字节（AES-256），即 44 个字符、以 = 结尾。
# 生成：openssl rand -base64 32
# 【不可更改】换掉它会让已加密的 OSS 凭据永远无法解密，只能重新录入。
APP_ENCRYPT_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 6. Docling（文档解析服务）
# ─────────────────────────────────────────────────────────────────────────────
# 【必填】解析服务地址与令牌，上传文档后需要它把 PDF/图片转成文本。
# API_TOKEN 至少 32 个字符，不足会导致启动失败（DoclingClient 构造器里校验）。
# 【注意】docling 是独立运行的进程，不在 infra compose 里，所以这里用实际地址，
# 不能用服务名。若它与 app 在同一台机器，就是下面这个值。
APP_DOCLING_BASE_URL=http://127.0.0.1:8091
APP_DOCLING_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# 7. 演示模式总开关
# ─────────────────────────────────────────────────────────────────────────────
# 【必填】设为 true 才会启用整套演示逻辑。设为 false 时下面所有 APP_DEMO_* 都不生效。
APP_DEMO_ENABLED=true

# 单张令牌的额度（默认 10 次）
APP_DEMO_TOKEN_QUOTA=10

# 单张令牌的有效期，单位小时（默认 2）
APP_DEMO_TOKEN_TTL_HOURS=2

# 全站每日可计费操作总数，这是成本天花板（默认 80）
APP_DEMO_DAILY_OPERATION_LIMIT=80

# 全站每日最多签发多少张令牌（默认 50）
APP_DEMO_DAILY_TOKEN_LIMIT=50

# 同一浏览器的发券冷却，防误点（默认 10 分钟）
APP_DEMO_ISSUE_COOLDOWN_MINUTES=10

# 单次上传允许的文件数（默认 1）
APP_DEMO_UPLOAD_MAX_FILES=1

# 启动时是否直接熔断。用于「先部署、确认无误后再开放」的流程（默认 false）
APP_DEMO_START_CLOSED=false

# ─────────────────────────────────────────────────────────────────────────────
# 8. 人机校验（阿里云验证码 2.0）
# ─────────────────────────────────────────────────────────────────────────────
# 【必填】开关。设为 true 时，下面 SCENE_ID / ACCESS_KEY 两项也会变成必填，
#         缺了会导致启动失败（启动时就报错，好过在访客面前报错）。
APP_DEMO_CAPTCHA_ENABLED=true

# 【必填】阿里云控制台 → 场景管理 里的场景 ID，形如 15b5bm9o
APP_DEMO_CAPTCHA_SCENE_ID=

# 【必填】同一页面的 prefix，形如 x84y6v。前端 SDK 用它拼接请求域名。
APP_DEMO_CAPTCHA_PREFIX=

# 服务端校验时用的 region，目前固定 cn-shanghai。
# 注意：这和前端 SDK 的 region 是两套命名，前端传 "cn"，服务端传 "cn-shanghai"。
APP_DEMO_CAPTCHA_REGION=cn-shanghai

# 【必填】服务端校验用的 RAM 凭据（只用于调用 VerifyIntelligentCaptcha，
#         需要 AliyunVerificationCodeFullAccess 或等效权限即可）。
# 与 OSS 上传用的 RAM 用户可以是同一个，也可以分开。
APP_DEMO_CAPTCHA_ACCESS_KEY_ID=
APP_DEMO_CAPTCHA_ACCESS_KEY_SECRET=

# 加密模式密钥，从阿里云控制台「概览」页右上角复制。
# 【关键】这一项和控制台的「加密模式」开关必须保持一致：
#   控制台开 + 这里 ENCRYPT=true  → 正常
#   控制台开 + 这里 ENCRYPT=false → 全部访客 F022
#   控制台关 + 这里 ENCRYPT=true  → 全部访客 F022
APP_DEMO_CAPTCHA_EKEY=

# 加密模式开关。控制台开了就设 true，没开就设 false（默认 false）。
APP_DEMO_CAPTCHA_ENCRYPT_SCENE_ID=true

# 加密串的有效期，单位秒，范围 1~86400（默认 3600）。
# 太短会导致访客停留久了首次点击就失败，太长会削弱加密意义。
APP_DEMO_CAPTCHA_SCENE_ID_TTL_SECONDS=3600

# ─────────────────────────────────────────────────────────────────────────────
# 附：自查清单
# ─────────────────────────────────────────────────────────────────────────────
# 部署前逐条确认：
#
#   [ ] ES_HOST / ES_USERNAME / ES_PASSWORD 已填（无默认值，缺了启动失败）
#   [ ] APP_DOCLING_API_TOKEN 至少 32 字符
#   [ ] MYSQL_URL 的 serverTimezone=Asia/Shanghai 没丢
#   [ ] APP_ADMIN_SECRET 已生成且不是 change-me
#   [ ] APP_ENCRYPT_KEY 是 Base64 的 32 字节（44 字符）
#   [ ] APP_DEMO_CAPTCHA_ENCRYPT_SCENE_ID 与阿里云控制台的加密开关一致
#   [ ] APP_DEMO_CAPTCHA_EKEY 是从控制台当场复制的（不是旧记录里的）
#   [ ] SPRING_DATA_REDIS_DATABASE 已设为 4（与主环境隔离）
#   [ ] ANCHR_SEGMENT_INDEX=demo_kb_segment（与主环境隔离）
#   [ ] OSS 桶的跨域白名单包含演示站域名，且允许 Headers 为 *
#   [ ] 演示站域名已在阿里云验证码控制台绑定
