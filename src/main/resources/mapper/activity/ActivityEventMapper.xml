<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anchr.core.activity.infrastructure.persistence.ActivityEventMapper">

    <resultMap id="ActivityEventRecordMap" type="com.anchr.core.activity.infrastructure.persistence.ActivityEventRecord">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="eventType" column="event_type"/>
        <result property="resourceType" column="resource_type"/>
        <result property="resourceId" column="resource_id"/>
        <result property="payload" column="payload"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="ActivityEventColumns">
        id, user_id, event_type, resource_type, resource_id, payload, created_at
    </sql>

    <insert id="insert" parameterType="com.anchr.core.activity.infrastructure.persistence.ActivityEventRecord">
        insert into activity_event (
            <include refid="ActivityEventColumns"/>
        ) values (
            #{id}, #{userId}, #{eventType}, #{resourceType}, #{resourceId}, #{payload}, #{createdAt}
        )
    </insert>

    <select id="listByType" resultMap="ActivityEventRecordMap">
        select
            <include refid="ActivityEventColumns"/>
        from activity_event
        where user_id = #{userId}
          and event_type = #{eventType}
        <if test="since != null">
            and created_at &gt;= #{since}
        </if>
        order by created_at desc, id desc
        limit #{limit} offset #{offset}
    </select>
    <delete id="deleteBySessionId">
        delete from activity_event
        where event_type in ('QUESTION_ASKED', 'CITATION_OPENED')
          and JSON_UNQUOTE(JSON_EXTRACT(payload, '$.sessionId')) = #{sessionId}
    </delete>
    <delete id="deleteCitationOpenedByAssetId">
        delete from activity_event
        where user_id = #{userId}
          and event_type = 'CITATION_OPENED'
          and JSON_UNQUOTE(JSON_EXTRACT(payload, '$.assetId')) = #{assetId}
    </delete>

    <select id="searchById" resultMap="ActivityEventRecordMap">
        select
            <include refid="ActivityEventColumns"/>
        from activity_event
        where id = #{id}
        and event_type = #{eventType}
    </select>
</mapper>
