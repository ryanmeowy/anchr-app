<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anchr.core.auth.infrastructure.persistence.UserAccountMapper">

    <resultMap id="UserAccountMap" type="com.anchr.core.auth.infrastructure.persistence.UserAccountRecord">
        <id property="id" column="id"/>
        <result property="email" column="email"/>
        <result property="displayName" column="display_name"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="status" column="status"/>
        <result property="externalIssuer" column="external_issuer"/>
        <result property="externalSubject" column="external_subject"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="UserColumns">
        id, email, display_name, password_hash, status, external_issuer, external_subject, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.anchr.core.auth.infrastructure.persistence.UserAccountRecord">
        insert into user_account (
            <include refid="UserColumns"/>
        ) values (
            #{id}, #{email}, #{displayName}, #{passwordHash}, #{status},
            #{externalIssuer}, #{externalSubject}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <select id="count" resultType="long">
        select count(1) from user_account
    </select>

    <select id="findByEmail" resultMap="UserAccountMap">
        select <include refid="UserColumns"/>
        from user_account
        where email = #{email}
          and status = 'ACTIVE'
    </select>

    <select id="findById" resultMap="UserAccountMap">
        select <include refid="UserColumns"/>
        from user_account
        where id = #{id}
          and status = 'ACTIVE'
    </select>

    <select id="findByExternal" resultMap="UserAccountMap">
        select <include refid="UserColumns"/>
        from user_account
        where external_issuer = #{issuer}
          and external_subject = #{subject}
          and status = 'ACTIVE'
    </select>

    <update id="bindExternal">
        update user_account
        set external_issuer = #{issuer},
            external_subject = #{subject},
            updated_at = current_timestamp
        where id = #{id}
          and status = 'ACTIVE'
    </update>
</mapper>
