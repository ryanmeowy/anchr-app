<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anchr.core.kb.infrastructure.persistence.AssetIndexChangeMapper">

    <resultMap id="AssetIndexChangeRecordMap"
               type="com.anchr.core.kb.infrastructure.persistence.AssetIndexChangeRecord">
        <id property="revision" column="revision"/>
        <result property="eventId" column="event_id"/>
        <result property="kbId" column="kb_id"/>
        <result property="assetId" column="asset_id"/>
        <result property="operation" column="operation"/>
        <result property="indexGeneration" column="index_generation"/>
        <result property="occurredAt" column="occurred_at"/>
        <result property="createdBy" column="created_by"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.anchr.core.kb.infrastructure.persistence.AssetIndexChangeRecord"
            useGeneratedKeys="true" keyProperty="revision" keyColumn="revision">
        insert into asset_index_change (
            event_id, kb_id, asset_id, operation, index_generation, occurred_at, created_by
        ) values (
            #{eventId}, #{kbId}, #{assetId}, #{operation},
            #{indexGeneration}, #{occurredAt}, #{createdBy}
        )
    </insert>

    <select id="listAfterRevision" resultMap="AssetIndexChangeRecordMap">
        select revision, event_id, kb_id, asset_id, operation,
               index_generation, occurred_at, created_by
        from asset_index_change
        where revision &gt; #{exclusiveRevision}
        order by revision asc
        limit #{limit}
    </select>
</mapper>
