<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anchr.core.settings.infrastructure.persistence.AppSettingMapper">

    <resultMap id="AppSettingRecordMap" type="com.anchr.core.settings.infrastructure.persistence.AppSettingRecord">
        <id property="id" column="id"/>
        <result property="settingKey" column="setting_key"/>
        <result property="settingValue" column="setting_value"/>
        <result property="version" column="version"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="AppSettingColumns">
        id, setting_key, setting_value, version, updated_by, updated_at
    </sql>

    <select id="find" resultMap="AppSettingRecordMap">
        select
            <include refid="AppSettingColumns"/>
        from app_setting
        where setting_key = #{settingKey}
    </select>

    <insert id="upsert">
        insert into app_setting (
            id, setting_key, setting_value, version, updated_by, updated_at
        ) values (
            #{id}, #{settingKey}, #{settingValue}, 1, #{updatedBy}, #{updatedAt}
        )
        on duplicate key update
            setting_value = #{settingValue},
            version = version + 1,
            updated_by = #{updatedBy},
            updated_at = #{updatedAt}
    </insert>
</mapper>
