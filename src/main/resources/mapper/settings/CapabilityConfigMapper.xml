<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anchr.core.settings.infrastructure.persistence.CapabilityConfigMapper">

    <resultMap id="CapabilityConfigRecordMap" type="com.anchr.core.settings.infrastructure.persistence.CapabilityConfigRecord">
        <id property="id" column="id"/>
        <result property="capability" column="capability"/>
        <result property="baseUrl" column="base_url"/>
        <result property="apiKeyEnc" column="api_key_enc"/>
        <result property="modelName" column="model_name"/>
        <result property="imageModel" column="image_model"/>
        <result property="imageEndpoint" column="image_endpoint"/>
        <result property="enabled" column="enabled"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="capabilityConfigColumns">
        id, capability, base_url, api_key_enc, model_name,
        image_model, image_endpoint, extra_config, enabled, updated_by, updated_at
    </sql>

    <select id="findByCapability" resultMap="CapabilityConfigRecordMap">
        select <include refid="capabilityConfigColumns"/>
        from capability_config
        where capability = #{capability}
    </select>

    <insert id="upsert" parameterType="com.anchr.core.settings.infrastructure.persistence.CapabilityConfigRecord">
        insert into capability_config (
            <include refid="capabilityConfigColumns"/>
        ) values (
            #{id}, #{capability}, #{baseUrl}, #{apiKeyEnc}, #{modelName},
            #{imageModel}, #{imageEndpoint}, #{extraConfig}, #{enabled}, #{updatedBy}, #{updatedAt}
        ) on duplicate key update
            base_url = values(base_url),
            api_key_enc = values(api_key_enc),
            model_name = values(model_name),
            image_model = values(image_model),
            image_endpoint = values(image_endpoint),
            extra_config = values(extra_config),
            enabled = values(enabled),
            updated_by = values(updated_by),
            updated_at = values(updated_at)
    </insert>
</mapper>
